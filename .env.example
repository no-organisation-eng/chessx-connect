# Blockchain Deployment Secrets
# NEVER commit the real .env file to version control

# The private key of the account that will deploy the contracts
# (This should be the same as the one in your Supabase secrets)
PRIVATE_KEY=your_private_key_here

# The address that will receive platform fees
TREASURY_ADDRESS=0x...your_treasury_wallet

# The address authorized to resolve matches (Oracle)
# (In your case, usually the same as the deployer or a dedicated backend wallet)
ORACLE_ADDRESS=0x...your_backend_wallet

# Basescan API Key (Optional, for contract verification)
BASESCAN_API_KEY=your_basescan_key_here
